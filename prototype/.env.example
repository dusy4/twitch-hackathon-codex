# Environment variables used by bridge.mjs; source into your process via your shell or Node's --env-file flag.
# Register your app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
# USER ACCESS TOKEN, not application access token. Grant user:read:chat on the broadcaster's own account.
TWITCH_USER_TOKEN=
# Get a numeric ID with Twitch Helix Get Users.
TWITCH_BROADCASTER_ID=
# Optional, local bind only by default
PORT=8080
HOST=127.0.0.1
# Optional, for ai-verify.mjs
OPENAI_API_KEY=
