{
  "name": "raidrift",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && tsx apps/api/main.ts",
    "build": "vite build && npm run build:extension && tsc --noEmit",
    "build:extension": "vite build --config apps/twitch-extension/vite.config.ts && node scripts/verify-extension-build.mjs",
    "build:extension:local": "vite build --config apps/twitch-extension/vite.config.ts --mode local-test && node scripts/verify-extension-build.mjs --local",
    "start": "tsx apps/api/main.ts",
    "lan:test": "npm run build && tsx scripts/lan-test.ts",
    "tailnet:test": "npm run build && tsx scripts/tailnet-test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check apps/api apps/web/*.ts packages/shared tests/*.test.ts tests/e2e/*.ts apps/twitch-extension",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:extension": "playwright test --config playwright.extension.config.ts",
    "licenses": "node scripts/licenses.mjs",
    "setup:vision": "node scripts/setup-vision.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@electric-sql/pglite": "0.3.14",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.8",
    "@fontsource/space-grotesk": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@iwer/sem": "2.7.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "iwer": "2.7.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
