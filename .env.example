# Local app: no credentials required for clearly labelled simulator.
PUBLIC_URL=http://127.0.0.1:3400
PORT=3400
HOST=127.0.0.1
DEMO_ENABLED=true
# Production must set NODE_ENV=production, DEMO_ENABLED=false, DATABASE_URL, APP_SECRET and REWARD_IDENTITY_SECRET.
DATABASE_URL=
APP_SECRET=
# Stable across APP_SECRET rotations; see docs/OPERATIONS.md before upgrading an existing database.
REWARD_IDENTITY_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_ACTION_MODEL=gpt-6-luna
OPENAI_DECISIONS_MODEL=gpt-6-luna
# Cost gate: keep false until owner explicitly authorizes paid inference.
ALLOW_PAID_AI=false
EXPERIMENTAL_CAMERA_REWARDS=false
ADMIN_TWITCH_IDS=
